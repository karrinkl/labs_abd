@startuml c4_context
' C4, уровень 1 — System Context
' Вариант №2: система обработки clickstream-данных для оптимизации воронки продаж.
' Все названия систем условные, данные синтетические.
' Библиотека C4-PlantUML подключается из стандартной библиотеки PlantUML (работает офлайн).
!include <C4/C4_Context>

LAYOUT_TOP_DOWN()
skinparam defaultFontName "DejaVu Sans"
skinparam wrapWidth 220
skinparam maxMessageSize 180

title C4, уровень 1 (System Context): платформа clickstream-аналитики воронки продаж (вариант №2)

Person(visitor, "Посетитель сайта", "Покупатель, просматривающий каталог и оформляющий заказ в браузере")

System_Ext(website, "Веб-сайт интернет-магазина", "Frontend с JS-трекером в браузере и backend, пишущий JSON-логи")
System_Ext(tracking, "Система веб-трекинга", "Внешний сервис веб-аналитики (условный)")
System_Ext(abplatform, "A/B-платформа", "Управление экспериментами и распределением пользователей по вариантам")
System_Ext(crm, "CRM", "Учёт заказов, оплат, отмен и клиентов")

System_Boundary(b, "Проектируемая система") {
  System(platform, "Платформа clickstream-аналитики", "Сбор, хранение (Lakehouse) и обработка событий; расчёт воронки, конверсий и результатов A/B-тестов")
}

System_Ext(bi, "BI-система", "Корпоративные дашборды (Apache Superset)")
System_Ext(ml, "ML-сервисы", "Персонализация, прогноз вероятности покупки")
System_Ext(apiconsumer, "Внешние потребители API", "Маркетинговая платформа, внутренние сервисы")

Person(analyst, "Аналитик данных", "Анализирует воронку, проводит ad-hoc исследования, оценивает A/B-тесты")
Person(pm, "Продуктовый менеджер", "Принимает решения по изменению воронки на основе дашбордов")
Person(de, "Дата-инженер", "Сопровождает конвейеры данных, схемы событий и повторную обработку")

Rel(visitor, website, "Просматривает товары, кладёт в корзину, оформляет заказ", "HTTPS")
Rel(visitor, tracking, "Обращения JS-тега веб-трекинга из браузера", "HTTPS")
Rel(website, platform, "Clickstream-события из браузера (JSON)", "HTTPS, поток")
Rel(website, platform, "JSON-логи сервера (запросы, ошибки, checkout)", "поток логов")
Rel(tracking, platform, "События веб-трекинга (визиты, источники трафика, UTM)", "Webhook / экспорт JSON")
Rel(abplatform, platform, "Параметры экспериментов и назначения вариантов", "REST API, пакетно")
Rel(crm, platform, "Сведения о заказах, оплатах и отменах", "Инкрементальная выгрузка, пакетно")

Rel(platform, bi, "Агрегированные показатели конверсии и результаты анализа воронки", "SQL (Trino)")
Rel(platform, apiconsumer, "Агрегированные метрики воронки и A/B-тестов", "REST API, JSON")
Rel(platform, ml, "Очищенные события сессий и признаки пользователей", "SQL / чтение таблиц Iceberg")

Rel_U(analyst, bi, "Изучает дашборды воронки и A/B-тестов")
Rel_U(pm, bi, "Отслеживает конверсию и потери на этапах")
Rel_U(analyst, platform, "Ad-hoc SQL-запросы к витринам и очищенным событиям", "SQL")
Rel_L(de, platform, "Настраивает схемы событий, запускает повторную обработку истории")

Lay_R(analyst, pm)
' Собственная легенда на русском (встроенная легенда C4-PlantUML выводит
' служебные символы, которые не отображаются некоторыми шрифтами)
HIDE_STEREOTYPE()
skinparam legendFontColor #000000
skinparam legendFontSize 13
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #888888
legend right
<b>Легенда</b>
|<#08427B>      | пользователь (роль) |
|<#1168BD>      | проектируемая система |
|<#999999>      | внешняя система |
| - - - | граница проектируемой системы |
| → | направление передачи данных / обращения |
endlegend
@enduml
