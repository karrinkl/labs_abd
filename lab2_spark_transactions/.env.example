# Скопируйте в .env:  cp .env.example .env   и подставьте свои UID/GID (команда: id -u ; id -g)

# --- Образ Spark (официальный Docker Official Image, версия зафиксирована) ---
# Spark 4.1.3, Scala 2.13, Java 21 (Eclipse Temurin), Python 3.10, Ubuntu 22.04
SPARK_IMAGE=spark:4.1.3-scala2.13-java21-python3-ubuntu

# --- Пользователь хоста, от имени которого работают контейнеры ---
HOST_UID=1000
HOST_GID=1000

# --- Ресурсы кластера (рассчитаны на ПК с 4+ ядрами и 8+ ГБ ОЗУ) ---
SPARK_WORKER_CORES=2          # ядер, которые Worker отдаёт executors
SPARK_WORKER_MEMORY=2g        # памяти, которую Worker отдаёт executors
SPARK_EXECUTOR_CORES=2        # ядер на один executor
SPARK_EXECUTOR_MEMORY=1g      # heap одного executor
SPARK_TOTAL_EXECUTOR_CORES=2  # предел ядер на приложение (= spark.cores.max)
SPARK_DRIVER_MEMORY=1g        # heap драйвера (в local[1] это и память задач)

# --- Параметры Spark SQL, одинаковые для всех режимов ---
SPARK_SHUFFLE_PARTITIONS=8    # spark.sql.shuffle.partitions (по умолчанию в Spark 200)
SPARK_MAX_PARTITION_BYTES=32m # spark.sql.files.maxPartitionBytes: размер входной партиции

# --- Данные и анализ ---
SEED=42
DATA_START=2025-01-01         # интервал временных меток (UTC), конец не включается
DATA_END=2026-01-01
AMOUNT_THRESHOLD=100          # порог x фильтра amount_eur > x (EUR)

# --- Замеры ---
BENCH_REPEATS=5               # число измеряемых повторов (плюс 1 прогревочный)
