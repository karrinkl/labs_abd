# Шаблон для запуска producer.py с ноутбука (Arch Linux). Скопируйте: cp .env.example .env
# Файл .env содержит адрес вашего сервиса — он в .gitignore, не публикуйте его.

# Service URI из Aiven Console → сервис Kafka → Overview → Connection information (вид host:port)
LAB3_BOOTSTRAP_SERVERS=
LAB3_TOPIC=bank-transactions-v2
# certificate (ca.pem + service.cert + service.key) или sasl (логин/пароль + ca.pem)
LAB3_AUTH_MODE=certificate
# Каталог с ca.pem, service.cert, service.key (права 700, ВНЕ репозитория и облачных дисков)
LAB3_SECRETS_DIR=~/.config/lab3-kafka
# Только для LAB3_AUTH_MODE=sasl (пароль лучше задавать в окружении, а не в файле)
LAB3_SASL_USERNAME=
LAB3_SASL_PASSWORD=
